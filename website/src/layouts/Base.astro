---
import "@fontsource/inter/400.css"
import "@fontsource/inter/600.css"
import "@fontsource/saira/600.css"
import "@fontsource/saira/700.css"
import "../styles/site.css"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import { siteMode } from "../lib/site"

interface Props {
  title: string
  description: string
  /** Legal and other pages that must not be indexed until counsel has reviewed them. */
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const fullTitle = title === "GreyGuard" ? "GreyGuard — agent security control plane" : `${title} · GreyGuard`
const indexable = siteMode === "publish" && !noindex
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={indexable ? "index, follow" : "noindex, nofollow"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#050a12" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon-180.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {siteMode === "preview" && (
      <p class="preview-banner" role="note">Preview build: not for publication. Claims not yet approved are marked.</p>
    )}
    <p class="announcement"><a href="/trust/#claims">Every claim on this site links to the evidence behind it <span aria-hidden="true">→</span></a></p>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
