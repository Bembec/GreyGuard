---
import Icon from "./Icon.astro"
import { availabilityLabel, getClaim } from "../lib/claims"
import { siteMode } from "../lib/site"

interface Props { ids: string[] }
const claims = Astro.props.ids.map((id) => getClaim(id))
---
<ul class="claim-list">
  {claims.map((claim) => (
    <li class:list={["claim-list__item", { "claim-list__item--unapproved": claim.status !== "approved" }]} data-claim={claim.id}>
      <Icon name="check" size={18} class="claim-list__icon" />
      <span>
        {claim.claim}
        <span class="claim-list__meta">
          <span class="badge" data-availability={claim.availability}>{availabilityLabel[claim.availability]}</span>
          {siteMode === "preview" && claim.status !== "approved" && <span class="badge badge--draft">Proposed · {claim.id}</span>}
        </span>
      </span>
    </li>
  ))}
</ul>
