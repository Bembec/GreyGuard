---
import { brandAsset } from "../lib/brand"
import { productName } from "../lib/decisions"

interface Props { size: number; class?: string }
const { size, class: className } = Astro.props
const asset = brandAsset("symbol")
---
<picture class={className} data-brand-slot="symbol">
  {asset.webp && <source srcset={asset.webp} type="image/webp" />}
  <img src={asset.path} alt={productName} width={size} height={size} />
</picture>
