---
import Base from "../layouts/Base.astro"
import Icon from "../components/Icon.astro"
import { demoContact } from "../lib/site"

const demoHref = demoContact ?? "/company/#contact"

// Only what exists today. Documentation is shared with evaluators on request until the public
// documentation site is published with the first release.
const resources = [
  { icon: "check", title: "Claim register", text: "Every product claim with its scope, maturity and evidence.", href: "/trust/#claims", cta: "Open the register", available: true },
  { icon: "gate", title: "Proof & Trust", text: "Assurance status and how to request evidence.", href: "/trust/", cta: "Visit Proof & Trust", available: true },
  { icon: "code", title: "Connection guide", text: "SDK examples and what each connection method covers.", href: "/environments/", cta: "See connection methods", available: true },
  { icon: "alert", title: "Responsible disclosure", text: "How to report a vulnerability privately.", href: "/security/", cta: "Report a vulnerability", available: true },
  { icon: "book", title: "Product documentation", text: "Administrator, installation, policy authoring and SDK guides. Shared with evaluators on request until the public documentation site launches.", href: demoHref, cta: "Request documentation", available: false },
  { icon: "pulse", title: "Release notes", text: "What changed in each release. Published with the first public release.", href: null, cta: "", available: false },
]
---
<Base title="Resources" description="GreyGuard resources: the claim register, trust information, connection guides, responsible disclosure and documentation.">
  <section class="hero hero--compact">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">Resources</p>
      <h1 class="hero__title">Everything you need to evaluate GreyGuard</h1>
      <p class="hero__lead">Start with the claim register and the connection guide. Detailed documentation is available to evaluators on request.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="resources-title">
    <div class="container">
      <h2 id="resources-title" class="visually-hidden">Resources</h2>
      <div class="threat-grid">
        {resources.map((item) => (
          <article class="threat resource-card">
            <div class="integration-card__head">
              <span class="icon-tile"><Icon name={item.icon as never} size={22} /></span>
              {!item.available && <span class="pill pill--muted">{item.href ? "On request" : "Coming with release"}</span>}
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {item.href && <a class="text-link" href={item.href}>{item.cta} <Icon name="arrow" size={16} /></a>}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
