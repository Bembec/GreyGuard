---
import Base from "../layouts/Base.astro"
import PageIntro from "../components/PageIntro.astro"
import PublicContact from "../components/PublicContact.astro"
---
<Base title="Status" description="Where to find GreyGuard's live service status." noindex>
  <PageIntro eyebrow="Support" title="Service status" lead="Live component status is published by the GreyGuard application itself, at its /status page, without signing in." />
  <section class="section">
    <div class="container">
      <div class="notice"><PublicContact kind="status" /></div>
    </div>
  </section>
</Base>
