---
import Base from "../layouts/Base.astro"
import PageIntro from "../components/PageIntro.astro"
---
<Base title="Accessibility" description="GreyGuard's accessibility statement for this site." noindex>
  <PageIntro eyebrow="Accessibility" title="Accessibility statement" lead="This site is built to meet WCAG 2.2 level AA." />
  <section class="section">
    <div class="container">
      <div class="notice">
        <h2>Statement in preparation</h2>
        <p>The full statement, including the results of the conformance check and how to report a barrier, will be published after the site's accessibility audit (P7.5).</p>
      </div>
    </div>
  </section>
</Base>
