---
import Base from "../layouts/Base.astro"
import PageIntro from "../components/PageIntro.astro"
---
<Base title="Sign in" description="Sign in to the GreyGuard administrator application." noindex>
  <PageIntro eyebrow="Customers" title="Sign in" lead="The GreyGuard console is a separate application with its own address and security boundary. This site never handles your credentials." />
  <section class="section">
    <div class="container">
      <div class="notice">
        <p>Use the console address your organization was given. A public sign-in link will appear here once the hosted console's address is set.</p>
      </div>
    </div>
  </section>
</Base>
