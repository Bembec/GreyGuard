---
import Base from "../layouts/Base.astro"
import Icon from "../components/Icon.astro"
import ClaimList from "../components/ClaimList.astro"
import DemoRequestDestination from "../components/DemoRequestDestination.astro"
import PlanDisplay from "../components/PlanDisplay.astro"
import PublicContact from "../components/PublicContact.astro"
import SupportInformation from "../components/SupportInformation.astro"

// Principles from the roadmap's product boundary: what GreyGuard is, and what it will not become.
const principles = [
  { icon: "gate", title: "Control, not surveillance", text: "GreyGuard governs the actions agents take. It does not monitor people, and its endpoint telemetry is visible and consent-bound." },
  { icon: "lock", title: "Defend and contain, never retaliate", text: "There is no hack-back and no offensive capability. Prohibited behaviour exists only as blocked, non-operational simulation." },
  { icon: "evidence", title: "Prove, don't promise", text: "Every product claim carries its scope, availability and evidence, and limitations are published beside capabilities." },
  { icon: "check", title: "Fail closed", text: "When something is unknown, unavailable or unapproved, the safe default is to refuse." },
]
---
<Base title="Company" description="About GreyGuard: the security control plane for AI agents, the principles behind it, and how to contact us.">
  <section class="hero hero--compact">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">Company</p>
      <h1 class="hero__title">Building the control plane for AI agents</h1>
      <p class="hero__lead">AI agents are starting to act on behalf of organizations: calling tools, changing records and moving data. GreyGuard exists so that every one of those actions is identified, authorized, approved where it matters, and provable afterwards.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Principles</p>
        <h2 id="principles-title">What we will and won't build</h2>
      </div>
      <div class="threat-grid principle-grid">
        {principles.map((item) => (
          <article class="threat">
            <span class="icon-tile"><Icon name={item.icon as never} size={22} /></span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band" id="contact" aria-labelledby="contact-title">
    <div class="container feature">
      <div class="feature__copy">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">Talk to us</h2>
        <p class="feature__problem">See GreyGuard run your own agent scenarios on synthetic data, or plan a pilot.</p>
        <DemoRequestDestination />
      </div>
      <div class="feature__panel">
        <h3>Security reports</h3>
        <p>Found a vulnerability? Report it privately.</p>
        <PublicContact kind="security" />
        <h3>Support</h3>
        <PublicContact kind="support" />
        <SupportInformation />
      </div>
    </div>
  </section>

  <section class="section" id="plans" aria-labelledby="plans-title">
    <div class="container feature">
      <div class="feature__copy">
        <p class="eyebrow">Plans</p>
        <h2 id="plans-title">Plans and pricing</h2>
        <PlanDisplay />
      </div>
      <div class="feature__panel">
        <h3>Included in every plan</h3>
        <ClaimList ids={["GG-PLAT-4"]} />
      </div>
    </div>
  </section>
</Base>
