---
import Base from "../layouts/Base.astro"
import Icon from "../components/Icon.astro"
import { availabilityLabel, claimsInGroup, controlLabel, type Claim } from "../lib/claims"
import { siteMode } from "../lib/site"

const groups = [
  { id: "gate", name: "Gate" },
  { id: "watch", name: "Watch" },
  { id: "respond", name: "Respond" },
  { id: "evidence", name: "Evidence" },
  { id: "connect", name: "Connection methods" },
  { id: "integrate", name: "Integrations" },
  { id: "platform", name: "Platform" },
  { id: "trust", name: "Assurance" },
]

const testCount = (claim: Claim) => claim.evidence.filter((reference) => reference.includes("::") || /\/test_[^/]+\.py$/.test(reference)).length
const all = groups.flatMap((group) => claimsInGroup(group.id))

const status = [
  { icon: "check", title: "Claims with evidence", value: `${all.filter((claim) => claim.availability === "verified" && claim.kind === "capability").length} verified`, text: "Every verified capability is backed by automated tests." },
  { icon: "alert", title: "Independent penetration test", value: "Not yet performed", text: "We will publish a summary once an independent test is complete." },
  { icon: "evidence", title: "Certifications", value: "None held", text: "SOC 2, ISO 27001 and similar programmes are planned, not claimed." },
  { icon: "gate", title: "Vulnerability reporting", value: "Private reporting open", text: "Report issues privately. See responsible disclosure." },
]
---
<Base title="Proof & Trust" description="GreyGuard's assurance status and public claim register: every claim, its scope, its availability and the evidence behind it.">
  <section class="hero hero--compact">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">Proof & Trust</p>
      <h1 class="hero__title">What we claim, and how you can check it</h1>
      <p class="hero__lead">Security buyers are asked to trust a lot of marketing. We publish every product claim with its scope, its availability and the evidence behind it, including what we have not done yet.</p>
      <nav class="subnav" aria-label="On this page">
        <a href="#status"><Icon name="pulse" size={16} />Assurance status</a>
        <a href="#claims"><Icon name="check" size={16} />Claim register</a>
        <a href="#evidence-requests"><Icon name="evidence" size={16} />Request evidence</a>
      </nav>
    </div>
  </section>

  <section class="section" id="status" aria-labelledby="status-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Assurance status</p>
        <h2 id="status-title">Where we stand today</h2>
      </div>
      <div class="status-grid">
        {status.map((item) => (
          <article class="status-card">
            <span class="icon-tile"><Icon name={item.icon as never} size={20} /></span>
            <p class="status-card__title">{item.title}</p>
            <p class="status-card__value">{item.value}</p>
            <p class="status-card__text">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band" id="claims" aria-labelledby="claims-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Claim register</p>
        <h2 id="claims-title">Every claim on this site</h2>
        <p class="section-head__lead">
          <strong>Availability</strong> says how mature a capability is: verified, pilot, preview or planned.{" "}
          <strong>Control</strong> says how it acts: enforced, observed, advisory or simulated.{" "}
          Each claim is reviewed on a schedule and withdrawn, not quietly edited, when it stops being true.
        </p>
        <nav class="subnav" aria-label="Claim groups">
          {groups.map((group) => <a href={`#claims-${group.id}`}>{group.name}</a>)}
        </nav>
      </div>
      {groups.map((group) => {
        const claims = claimsInGroup(group.id)
        return claims.length > 0 && (
          <div class="register-group" id={`claims-${group.id}`}>
            <h3>{group.name}</h3>
            <div class="register-table" role="region" aria-label={`${group.name} claims`} tabindex="0">
              <table>
                <thead>
                  <tr><th scope="col">Claim</th><th scope="col">Scope</th><th scope="col">Availability</th><th scope="col">Control</th><th scope="col">Evidence</th></tr>
                </thead>
                <tbody>
                  {claims.map((claim) => (
                    <tr class:list={{ "is-unapproved": claim.status !== "approved" }}>
                      <td>
                        <span class="register-claim">{claim.claim}</span>
                        <span class="register-id">{claim.id}{claim.kind === "limitation" && " · Limitation"}{siteMode === "preview" && claim.status !== "approved" && " · Proposed, not approved"}</span>
                      </td>
                      <td class="register-scope">{claim.scope}</td>
                      <td><span class="badge" data-availability={claim.availability}>{availabilityLabel[claim.availability]}</span></td>
                      <td>{claim.control ? <span class="badge badge--control">{controlLabel[claim.control]}</span> : <span class="muted">—</span>}</td>
                      <td class="register-evidence">{testCount(claim) > 0 ? `${testCount(claim)} automated test${testCount(claim) === 1 ? "" : "s"}` : claim.evidence.length > 0 ? "Documentation" : "Not built yet"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )
      })}
    </div>
  </section>

  <section class="section" id="evidence-requests" aria-labelledby="requests-title">
    <div class="container feature">
      <div class="feature__copy">
        <p class="eyebrow">Evidence requests</p>
        <h2 id="requests-title">Ask for the evidence behind any claim</h2>
        <p class="feature__problem">Security reviewers can request the tests, design documents and records behind a claim.</p>
        <ol class="feature__how">
          <li>Public material on this site is available to anyone, without an agreement.</li>
          <li>Non-public evidence is approved by a GreyGuard platform administrator or our security owner.</li>
          <li>Detailed architecture, test findings and sensitive controls are shared under a non-disclosure agreement.</li>
          <li>Every request, approval and disclosure is recorded.</li>
        </ol>
      </div>
      <div class="feature__panel">
        <h3>Found a vulnerability?</h3>
        <p>Please report it privately so it can be fixed before it is disclosed.</p>
        <a class="button button--ghost" href="/security/">Responsible disclosure <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</Base>
