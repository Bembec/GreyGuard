GREYGUARD_ENV=production
GREYGUARD_BOOTSTRAP_EMAIL=owner@example.com
GREYGUARD_BOOTSTRAP_PASSWORD=replace-with-a-secret-of-at-least-16-characters
GREYGUARD_BOOTSTRAP_NAME=Platform Administrator
GREYGUARD_ALLOWED_ORIGINS=https://greyguard.example.com
GREYGUARD_TRUSTED_HOSTS=greyguard.example.com
GREYGUARD_DATA_DIR=/app/backend/data
GREYGUARD_BEHIND_PROXY=true
GREYGUARD_POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Required only if an enterprise OIDC identity provider is enabled (enterprise_identity /
# enterprise_sso): the public HTTPS callback URL registered with every configured provider.
# GREYGUARD_SSO_REDIRECT_URI=https://greyguard.example.com/auth/sso/callback

# Required only to enable agent certificate (mTLS) authentication, alongside the matching
# ssl_client_certificate/ssl_verify_client configuration in deployment/nginx-tls.conf. Leave
# unset to keep X-SSL-Client-* headers untrusted even if something forwards them.
# See docs/agent-certificate-authentication.md.
# GREYGUARD_TRUST_CLIENT_CERT_HEADERS=true
