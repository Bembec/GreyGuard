GREYGUARD_ENV=production
GREYGUARD_BOOTSTRAP_EMAIL=owner@example.com
GREYGUARD_BOOTSTRAP_PASSWORD=replace-with-a-secret-of-at-least-16-characters
GREYGUARD_BOOTSTRAP_NAME=Platform Administrator
GREYGUARD_ALLOWED_ORIGINS=https://greyguard.example.com
GREYGUARD_TRUSTED_HOSTS=greyguard.example.com
GREYGUARD_DATA_DIR=/app/backend/data
GREYGUARD_BEHIND_PROXY=true
GREYGUARD_POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# GREYGUARD_DATABASE_URL is NOT set here on purpose: docker-compose.production.yml builds it
# automatically from GREYGUARD_POSTGRES_PASSWORD above. Only set it directly if you are running
# the backend outside that Compose file. db_compat.py refuses to start with GREYGUARD_ENV=production
# unless this resolves to a PostgreSQL URL - SQLite is a development/test-only fallback.

# Never set GREYGUARD_ADMIN_PIN here. It is a development-only shared admin login and
# production_config.py refuses to start if it is set while GREYGUARD_ENV=production - use named
# administrator accounts (with MFA) or enterprise SSO (enterprise_identity / enterprise_sso) instead.

# Required only to enable signed report manifests (report_governance.signed_manifest): a plain
# secret string of at least 32 characters, used as an HMAC-SHA256 key. Leave unset to keep report
# signing unavailable rather than silently issuing unsigned manifests.
# GREYGUARD_REPORT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Required only to enable signed policy integration bundles (policy_integrations._bundle_key):
# a plain secret string of at least 32 characters, used as an HMAC-SHA256 key.
# GREYGUARD_POLICY_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Required only to enable encrypted database backups (encrypted_backups.py): generate with
# `python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`.
# Must decode to exactly 32 bytes (AES-256-GCM key). Losing this key makes existing encrypted
# backups unrecoverable - store it outside the backup itself, e.g. in a secrets manager.
# GREYGUARD_BACKUP_KEY=replace-with-a-urlsafe-base64-encoded-32-byte-key

# Required only to sign release manifests (release_integrity.py) as part of the release process,
# not routine operation. Same generation command as GREYGUARD_BACKUP_KEY above (Ed25519 seed).
# GREYGUARD_RELEASE_SIGNING_KEY=replace-with-a-urlsafe-base64-encoded-32-byte-key

# Required only if the HashiCorp Vault secret provider (secret_providers.py) is used to resolve
# a referenced secret at runtime. Not needed for the ENVIRONMENT provider (the default).
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=replace-with-a-scoped-vault-token

# Optional tuning for the background outbound-delivery worker (outbound_worker.py). Safe
# defaults apply if unset: enabled, 15 second poll interval, batch limit of 25 rows per queue.
# GREYGUARD_DELIVERY_WORKER_ENABLED=true
# GREYGUARD_DELIVERY_INTERVAL_SECONDS=15
# GREYGUARD_DELIVERY_BATCH_LIMIT=25

# Required only if an enterprise OIDC identity provider is enabled (enterprise_identity /
# enterprise_sso): the public HTTPS callback URL registered with every configured provider.
# GREYGUARD_SSO_REDIRECT_URI=https://greyguard.example.com/auth/sso/callback

# Required only to enable agent certificate (mTLS) authentication, alongside the matching
# ssl_client_certificate/ssl_verify_client configuration in deployment/nginx-tls.conf. Leave
# unset to keep X-SSL-Client-* headers untrusted even if something forwards them.
# See docs/agent-certificate-authentication.md.
# GREYGUARD_TRUST_CLIENT_CERT_HEADERS=true

# Required only to enable quarantined-artifact malware scanning (isolation_operations /
# malware_scanner). Leave unset to keep the scan endpoint failing closed with no attempt to
# reach a scanner. GREYGUARD_CLAMD_HOST/PORT only matter once scanning is enabled.
# See docs/isolation-operations.md.
# GREYGUARD_MALWARE_SCANNING_ENABLED=true
# GREYGUARD_CLAMD_HOST=127.0.0.1
# GREYGUARD_CLAMD_PORT=3310
